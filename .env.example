# Which environment this process is: development (the default) or
# production. Only production reports to PostHog. Deployed images set it
# themselves; nothing infers it from a hostname or a log level.
APP_ENV=development

# ---- catalog ----
#
# Postgres holds the whole movie catalog, built from the IMDb datasets by
# cmd/importer. The API only ever reads it; the importer is the only
# thing that writes. See internal/catalog/README.md.
DATABASE_URL=postgres://user:password@localhost:5432/cinedikt

# Connection pools, kept apart so a bulk COPY during an import cannot
# take the connections a reader needs. Unset takes the defaults in
# internal/config/config.go (10 and 4).
CATALOG_API_MAX_CONNS=
CATALOG_IMPORTER_MAX_CONNS=

# OMDb (omdbapi.com) supplies what the IMDb dump has not: a poster
# address, a full release date and a synopsis. The key never leaves the
# server. Leave empty and the catalog still works, without pictures and
# with cards ordered by year alone.
OMDB_API_KEY=

# How fast the poster backfill asks, and how many lookups run at once.
# There are about 757,000 movies, so a full first pass is roughly
# 757000/rate seconds. The workers are what make the rate reachable: one
# lookup at a time is bounded by the round trip, not by the limit.
# Unset takes the defaults (500/s over 256 workers).
OMDB_BACKFILL_RATE=
POSTER_WORKERS=

# Synopses come from OMDb too: the poster pass keeps the plot with every
# answer, and a second job asks for the titles it reached before it did,
# sharing its rate and its daily limit. That job asks first about films
# a reader has been shown, then about films with at least this many
# votes, most voted first. Unset takes 0: every film. A higher floor
# leaves the rest until a reader is shown them.
SYNOPSIS_SWEEP_MIN_VOTES=

# The second chance. OMDb has a poster for about 59% of the catalog;
# TMDb has one for roughly three-quarters of what is left. Set the two
# TMDb credentials below to turn the fallback on — without them those
# movies simply have no picture.
#
# A movie is fetched from TMDb when a reader has opened one with no
# picture, and otherwise only when it is at least this well known.
# Around 310,000 titles have no poster and about 1,300 of them have a
# hundred votes, so the default sweep is half a minute of work and the
# rest are repaired the moment somebody meets them.
#
# Set this to 0 to ask TMDb about every title with no picture, however
# obscure: about 300,000 lookups, roughly four hours at 20 a second, and
# the same again, spread out, as TMDb's terms have each answer asked
# again after 150 days. Worth knowing before you do: the well-known end
# of that queue yields a poster about 77% of the time, the zero-vote
# tail about 8%. Anything a reader actually opens is already fetched at
# any floor, because opening it marks the row as wanted.
TMDB_SWEEP_MIN_VOTES=

# A Telegram bot that keeps a pinned status board of the catalog jobs
# and sends a message when there is news: quietly for a new catalog or
# a fix, with a sound only for what has lasted or needs you. Leave both
# empty and nothing is sent. The token comes from BotFather. The chat
# id is message.chat.id from getUpdates after you have opened the bot
# and tapped Start — a private chat is a positive number, a group is
# negative.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The zone those messages write times in, such as Africa/Lagos. Unset
# means UTC, and the board says so.
NOTIFY_TIMEZONE=

# ---- serving ----

API_ADDR=:8080
# Serve the built frontend from here (run `npm run build` in web/ first).
WEB_DIR=web/dist

# Railway and the like inject this; API_ADDR wins when both are set.
PORT=

# PostHog, read only when APP_ENV=production. The API serves these to the
# map from GET /api/analytics-config; the project token is a write-only
# key, the same credential posthog-js would otherwise be built with.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Mixpanel, the same way: read only in production and served to the map
# from GET /api/analytics-config, so each environment sets its own project
# here and no build changes. Empty, and the page never loads Mixpanel.
MIXPANEL_PROJECT_TOKEN=

# ---- TMDb ----
#
# Read by the catalog: the poster fallback, the map from a TMDb id to
# the IMDb title an empty search resolves against, trailers, and
# people's photos. Either credential is enough, and the access token is
# preferred when both are set.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
# Requests a second for the whole process. TMDb counts about 40 a second
# per address, not per key, so every TMDb client and job in the process
# waits on one limiter at this rate. Unset takes 20, half of TMDb's
# ceiling; anything below 1 is refused at startup.
TMDB_RATE_PER_SEC=

# How well known a film has to be for the trailer job's sweep to reach
# it. Unset takes 0: every film. The endpoint only reads, so a film below
# a higher floor is looked up only once a reader opens it, and that
# reader waits a few seconds on the job.
TRAILER_SWEEP_MIN_VOTES=

# People's photos come from TMDb too. A map only reads them; the people
# job looks them up, the people on a map a reader opens first, then
# everyone a map can show whose best known movie has at least this many
# votes, most voted first. Unset takes 0: everyone. Below a higher floor
# a person is looked up only once a map with them on it is opened.
PEOPLE_SWEEP_MIN_VOTES=
# How many lookups a second that sweep, and the job's re-asks after 150
# days, may take out of TMDB_RATE_PER_SEC. The sweep is over a million
# people long, so it keeps to a share of the budget and leaves the rest
# to what readers are waiting on; the people on a map a reader opens
# skip it. Unset takes 5, which is about three days for the first sweep.
# Must be more than 0.
PEOPLE_SWEEP_RATE=

# ---- the old crawling map ----
#
# These belong to the Neo4j map the catalog replaced. Nothing reads them
# while DATABASE_URL is set, and a deployment does not need them. They
# are still accepted so the old path can be run until its packages come
# out of the tree.
TMDB_CACHE_TTL=168h
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=
CRAWL_THRESHOLD_BASE=
CRAWL_ORDER_PENALTY=
MAX_COLD_CRAWLS=
